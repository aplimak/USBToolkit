<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="?attr/colorSurfaceContainer">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceContainer"
        app:title="Gadget Info"
        app:titleCentered="false"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="@dimen/gap_xlarge">

            <ir.aeliux.usbtoolkit.widget.MaterialContainer
                android:id="@+id/sec_udc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerText="UDC">

                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_bound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Status"
                    app:attachMasterListener="false" />
                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_bound_udc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Bound UDC"
                    app:attachMasterListener="false" />
            </ir.aeliux.usbtoolkit.widget.MaterialContainer>

            <ir.aeliux.usbtoolkit.widget.MaterialContainer
                android:id="@+id/sec_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerText="Device">

                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_vendor_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Vendor Id"
                    app:attachMasterListener="false" />
                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_product_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Product Id"
                    app:attachMasterListener="false" />
                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_manufacturer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Manufacturer"
                    app:attachMasterListener="false" />
                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_product"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Product"
                    app:attachMasterListener="false" />
                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_serial_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Serial Number"
                    app:attachMasterListener="false" />
            </ir.aeliux.usbtoolkit.widget.MaterialContainer>

            <ir.aeliux.usbtoolkit.widget.MaterialContainer
                android:id="@+id/sec_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerText="USB">

                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_bm_attributes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Flags"
                    app:attachMasterListener="false" />
                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_bcd_usb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="USB Version"
                    app:attachMasterListener="false" />
                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/info_bcd_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Device Version"
                    app:attachMasterListener="false" />
            </ir.aeliux.usbtoolkit.widget.MaterialContainer>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>