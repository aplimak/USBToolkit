<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurfaceContainer"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:title="@string/activity_gadget_details"
        app:titleCentered="false" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/gap_xlarge"
            android:orientation="vertical">

            <ir.aeliux.ui.widget.MaterialContainer
                android:id="@+id/sec_udc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerText="@string/udc">

                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_bound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/status" />
                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_bound_udc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/bound_udc" />
            </ir.aeliux.ui.widget.MaterialContainer>

            <ir.aeliux.ui.widget.MaterialContainer
                android:id="@+id/sec_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerText="@string/device">

                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_vendor_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/vendor_id" />
                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_product_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/product_id" />
                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_manufacturer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/manufacturer" />
                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_product"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/product" />
                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_serial_number"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/serial_number" />
            </ir.aeliux.ui.widget.MaterialContainer>

            <ir.aeliux.ui.widget.MaterialContainer
                android:id="@+id/sec_usb"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerText="@string/usb">

                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_bm_attributes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/usb_bm_attributes" />
                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_bcd_usb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/usb_version" />
                <ir.aeliux.ui.widget.MaterialItem
                    android:id="@+id/info_bcd_device"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:attachMasterListener="false"
                    app:itemTitle="@string/device_version" />
            </ir.aeliux.ui.widget.MaterialContainer>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
