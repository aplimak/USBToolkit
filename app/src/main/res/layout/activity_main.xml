<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="?attr/colorSurfaceContainer">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurfaceContainer"
        app:title="@string/app_name"
        app:titleCentered="false"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/doAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:src="@drawable/ic_play_arrow"
        android:visibility="gone"
        android:layout_margin="@dimen/gap_xlarge" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ir.aeliux.usbtoolkit.widget.MaterialContainer
                android:id="@+id/sec_files"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerText="Files">

                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/btn_add_file"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemTitle="Add"
                    app:itemIcon="@drawable/ic_add"
                    app:isClickable="true" />
            </ir.aeliux.usbtoolkit.widget.MaterialContainer>

            <ir.aeliux.usbtoolkit.widget.MaterialContainer
                android:id="@+id/sec_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:headerText="Settings">

                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/sch_readonly"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:isChecked="false"
                    app:isClickable="true"
                    app:itemIcon="@drawable/ic_edit_off"
                    app:itemSubtitle="Mount files as immutable read only disks"
                    app:itemTitle="Read-Only"
                    app:showSwitch="true" />

                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/sch_cdrom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:isChecked="false"
                    app:isClickable="true"
                    app:itemIcon="@drawable/ic_album"
                    app:itemSubtitle="Mount files as CD-ROM disks"
                    app:itemTitle="CD-ROM"
                    app:showSwitch="true" />

                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/sch_removable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:isChecked="true"
                    app:isClickable="true"
                    app:itemIcon="@drawable/ic_eject"
                    app:itemSubtitle="Mount files as removable disks"
                    app:itemTitle="Removable"
                    app:showSwitch="true" />

                <ir.aeliux.usbtoolkit.widget.MaterialItem
                    android:id="@+id/sel_udc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:isClickable="true"
                    app:itemTitle="UDC"
                    app:itemSubtitle="Set USB Device Controller to bind gadget to it"
                    app:itemIcon="@drawable/ic_usb"
                    app:showDropdown="true" />
            </ir.aeliux.usbtoolkit.widget.MaterialContainer>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>