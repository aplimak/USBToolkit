<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <androidx.core.widget.NestedScrollView
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_start"
                    android:layout_marginEnd="@dimen/gap_medium"/>
                <Button
                    android:id="@+id/btn_stop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_stop" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>

                <Button
                    android:id="@+id/btn_reboot"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_reboot" />
            </LinearLayout>

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gap_xlarge">
                <TextView
                    android:text="@string/files_to_mount"
                    android:textFontWeight="600"
                    android:textSize="24sp"
                    android:layout_gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Space
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"/>
                <Button
                    android:id="@+id/btn_clear_files"
                    android:text="@string/clear"
                    android:layout_marginEnd="@dimen/gap_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
                <Button
                    android:id="@+id/btn_add_file"
                    android:text="@string/add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
            <ScrollView
                android:id="@+id/container_selected_files"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/gap_medium"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_selected_files"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                </LinearLayout>
            </ScrollView>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sch_readonly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="@dimen/gap_large"
                android:checked="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:textSize="16sp"
                android:text="@string/read_only"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sch_cdrom"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="@dimen/gap_medium"
                android:checked="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:textSize="16sp"
                android:text="@string/cd_rom"/>
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sch_removable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="@dimen/gap_medium"
                android:checked="true"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:textSize="16sp"
                android:text="@string/removable"/>
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="@dimen/gap_large"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="28dp"
        app:cardElevation="3dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:divider="?attr/colorOutlineVariant"
            android:showDividers="middle"
            android:dividerPadding="@dimen/gap_xlarge"
            android:paddingVertical="8dp">

            <!-- Toggle with subtitle -->
            <ir.aeliux.usbtoolkit.widgets.MaterialItem
                android:id="@+id/itemAutoSync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="Auto sync"
                app:itemSubtitle="Sync files automatically in background"
                app:showSwitch="true"
                app:isClickable="true"
                app:isChecked="true" />

            <!-- Clickable row (chevron only, no switch) -->
            <ir.aeliux.usbtoolkit.widgets.MaterialItem
                android:id="@+id/itemNotifications"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="Notifications"
                app:itemSubtitle="Get alerts when files are updated"
                app:isClickable="true"
                app:showChevron="true" />

            <!-- Toggle without subtitle -->
            <ir.aeliux.usbtoolkit.widgets.MaterialItem
                android:id="@+id/itemDarkMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="Dark theme"
                app:showSwitch="true"
                app:isChecked="false" />

            <!-- Dropdown -->
            <ir.aeliux.usbtoolkit.widgets.MaterialItem
                android:id="@+id/itemTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:itemTitle="App Theme"
                app:showDropdown="true"
                app:showChevron="true"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>