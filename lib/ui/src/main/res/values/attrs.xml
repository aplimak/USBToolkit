<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="MaterialItem">
        <!-- Core text -->
        <attr name="itemTitle" format="string" />
        <attr name="itemSubtitle" format="string" />
        <attr name="itemIcon" format="reference" />

        <!-- Behavioral toggles -->
        <attr name="showSwitch" format="boolean" />
        <attr name="dropdownEntries" format="reference" />
        <attr name="showChevron" format="boolean" />
        <attr name="attachMasterListener" format="boolean" />
        <attr name="isChecked" format="boolean" />
    </declare-styleable>
    <declare-styleable name="MaterialContainer">
        <attr name="headerText" format="string" />
    </declare-styleable>
</resources>