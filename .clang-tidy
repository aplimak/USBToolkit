---
Checks: >
  -*,

  android-*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,

  -readability-identifier-length,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers

WarningsAsErrors: ''

HeaderFilterRegex: '.*'
ExcludeHeaderFilterRegex: '(^|.*/)third_party(/|$)'
SystemHeaders: false

FormatStyle: file

CheckOptions:
  bugprone-exception-escape.TreatFunctionsWithoutSpecificationAsThrowing: 'All'
